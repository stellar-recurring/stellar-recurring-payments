{
  "name": "@recurring-subscriptions/keeper",
  "version": "0.1.0",
  "description": "Permissionless keeper bot that bills due SubscriptionVault subscriptions",
  "type": "module",
  "bin": {
    "subscription-keeper": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@recurring-subscriptions/sdk": "file:../sdk",
    "@stellar/stellar-sdk": "^13.0.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT OR Apache-2.0"
}
