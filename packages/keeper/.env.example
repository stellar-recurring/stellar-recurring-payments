# Soroban RPC endpoint (testnet example below)
RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase — must match RPC_URL
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Deployed SubscriptionVault contract ID (C...)
CONTRACT_ID=

# Keeper funding account secret (S...) — pays fees; process_payment is permissionless
KEEPER_SECRET_KEY=

# Poll loop interval in milliseconds
POLL_INTERVAL_MS=30000

# If true, simulate due bills but do not submit process_payment
DRY_RUN=true

# Persistent index of known subscription IDs + event cursor
STATE_FILE=./.keeper-state.json

# Optional: ledger to start event indexing from (defaults to latest-10_000)
# START_LEDGER=

# Optional: comma-separated IDs to always check (bootstrap without events)
# SUBSCRIPTION_IDS=1,2,3

# Optional: brute-force scan 1..N when the event index is empty
MAX_ID_SCAN=50

# Transaction fee in stroops
FEE=100000
