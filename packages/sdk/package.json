{
  "name": "@recurring-subscriptions/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Soroban Subscription Vault protocol",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stellar-recurring/stellar-recurring-payments.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/stellar-recurring/stellar-recurring-payments/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/stellar-recurring/stellar-recurring-payments/issues"
  },
  "keywords": [
    "stellar",
    "soroban",
    "subscription",
    "recurring-payments",
    "sdk"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^13.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "files": [
    "dist"
  ],
  "license": "MIT OR Apache-2.0"
}
